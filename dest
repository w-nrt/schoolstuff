#include <stdio.h>
#include <stdlib.h>
#include <math.h>

void appliquer(int tab[], int n, int (*f)(int)) {
    for (int i = 0; i < n; i++) {
        tab[i] = f(tab[i]);
    }
}

int compter(int tab[], int n, int (*predicat)(int)){
    int v=0;
    for (int i = 0; i < n; i++) {
        if (predicat(tab[i])) v++;
    }
    return v;
}

int carre(int x) {
    return x * x;
}

int oppose(int x) {
    return -x;
}

int estPair(int x){
    if (x % 2 == 0) return 1;
    return 0;
}

int estPositif(int x){
    if (x>=0) return 1;
    return 0;
}

int valeurAbsolute(int x){
    if (x<0) return -x;
    return x;
}

int incrementer(int x){
    return x+1;
}

int main(void){
    int t[10];
    int n = 10;

    for (int i=0; i<n; i++){
        t[i] = rand() % (50 - (-50) +1) + -50;
        printf("%d -- %d\n", i, t[i]);
    }

    printf("%d element sont positifs\n", compter(t, n, estPositif));
    return 0;
}
